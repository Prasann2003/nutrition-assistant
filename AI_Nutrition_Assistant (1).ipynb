   "source": [
    "# AI-Powered Nutrition Assistant using IBM Watsonx.ai"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 1: Install Required Libraries ---\n",
    "!pip install ibm-watsonx-ai ibm-cos-sdk openai Pillow SpeechRecognition gtts --quiet"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 2: Import Libraries ---\n",
    "import json\n",
    "import requests\n",
    "import io\n",
    "from PIL import Image\n",
    "import speech_recognition as sr\n",
    "from gtts import gTTS\n",
    "import IPython.display as display"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 3: IBM Watsonx.ai Setup ---\n",
    "from ibm_watsonx_ai.foundation_models import Model\n",
    "from ibm_watsonx_ai.foundation_models.utils.enums import ModelTypes\n",
    "\n",
    "# Replace with your IBM Cloud API key and project ID\n",
    "API_KEY = "<YOUR_IBM_API_KEY>"\n",
    "PROJECT_ID = "<YOUR_PROJECT_ID>"\n",
    "\n",
    "model = Model(\n",
    "    model_id=ModelTypes.GRANITE_13B_CHAT,\n",
    "    credentials={"apikey": API_KEY, "url": "https://us-south.ml.cloud.ibm.com"},\n",
    "    project_id=PROJECT_ID\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 4: Helper Function to Generate Responses ---\n",
    "def ask_watsonx(prompt):\n",
    "    response = model.generate(\n",
    "        prompt=prompt,\n",
    "        max_new_tokens=350,\n",
    "        temperature=0.7\n",
    "    )\n",
    "    return response[\"results\"][0][\"generated_text\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 5: Text Input Handling ---\n",
    "def handle_text_input(user_query):\n",
    "    prompt = f\"You are an AI-powered nutrition assistant. {user_query}\"\n",
    "    return ask_watsonx(prompt)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 6: Voice Input Handling ---\n",
    "def handle_voice_input(audio_path):\n",
    "    recognizer = sr.Recognizer()\n",
    "    with sr.AudioFile(audio_path) as source:\n",
    "        audio = recognizer.record(source)\n",
    "    query = recognizer.recognize_google(audio)\n",
    "    return handle_text_input(query)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 7: Image Input Handling ---\n",
    "# Dummy simulation for food recognition\n",
    "from torchvision import models, transforms\n",
    "import torch\n",
    "\n",
    "# Pretrained model for image classification\n",
    "resnet = models.resnet50(pretrained=True)\n",
    "resnet.eval()\n",
    "\n",
    "imagenet_labels = requests.get(\"https://raw.githubusercontent.com/pytorch/hub/master/imagenet_classes.txt\").text.split(\"\\n\")\n",
    "\n",
    "def handle_image_input(img_path):\n",
    "    image = Image.open(img_path).convert('RGB')\n",
    "    preprocess = transforms.Compose([\n",
    "        transforms.Resize(256),\n",
    "        transforms.CenterCrop(224),\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n",
    "    ])\n",
    "    img_tensor = preprocess(image).unsqueeze(0)\n",
    "    with torch.no_grad():\n",
    "        outputs = resnet(img_tensor)\n",
    "    _, predicted = outputs.max(1)\n",
    "    food_item = imagenet_labels[predicted]\n",
    "    prompt = f\"Provide nutritional information and meal plan suggestions based on {food_item}.\"\n",
    "    return ask_watsonx(prompt)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 8: Feedback-based Adaptation ---\n",
    "user_preferences = {}\n",
    "\n",
    "def adapt_with_feedback(feedback):\n",
    "    user_preferences[\"feedback\"] = feedback\n",
    "    prompt = f\"Based on previous recommendations and user feedback '{feedback}', adjust the future meal plans.\"\n",
    "    return ask_watsonx(prompt)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 9: Testing the Assistant ---\n",
    "print(\"=== AI Nutrition Assistant ===\")\n",
    "print(handle_text_input(\"Suggest a healthy high-protein vegetarian meal plan for a week.\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 10: Voice Response Output ---\n",
    "def speak_response(text):\n",
    "    tts = gTTS(text)\n",
    "    tts.save(\"response.mp3\")\n",
    "    display.display(display.Audio(\"response.mp3\"))"
   ]
  }
